{
  "name": "dbdash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:full": "./dev.sh",
    "dev:quick": "./dev.sh --skip-seed",
    "dev:reset": "./dev.sh --reset",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "docker compose up db -d",
    "db:stop": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up db -d",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "python3 etl/seed.py",
    "db:studio": "npx prisma studio",
    "schema:index": "npx tsx scripts/index-schema.ts",
    "nltk:setup": "pip3 install -r scripts/requirements.txt && python3 scripts/query_matcher.py build-fingerprints",
    "db:seed-golden": "python3 scripts/seed_golden_queries.py",
    "golden:generate": "python3 scripts/generate_golden_queries.py",
    "golden:generate-and-seed": "python3 scripts/generate_golden_queries.py && python3 scripts/seed_golden_queries.py --force && python3 scripts/query_matcher.py build-fingerprints"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@prisma/client": "^6.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-simple-maps": "^3.0.0",
    "recharts": "^2.15.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-simple-maps": "^3.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^6.9.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
